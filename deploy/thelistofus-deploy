#!/usr/bin/env bash
# Switches thelistofus.com to a build of one commit on main. Runs as root, started by the
# deploy key's forced command (deploy-gate) through a single sudoers rule. Installed to
# /usr/local/sbin/thelistofus-deploy by setup-server.sh.
#
#   thelistofus-deploy <40-char sha>  < build.tar.gz
#
# GitHub Actions builds the site (the Droplet is too small to build Next.js while serving
# three apps), posts the build's SHA-256 as a commit status on that commit, and streams
# the build here. This checks the commit is on main and the build matches that status,
# unpacks it into its own release folder, switches the `current` link, restarts the
# service, and puts the previous release back if the site doesn't answer.
set -euo pipefail

CONF=/etc/thelistofus-deploy.conf
# shellcheck source=/dev/null
source "$CONF" # APP_USER APP_HOME NODE_DIR BASE REPO SERVICE PORT AASA_DIR

MAX_BYTES=$((400 * 1024 * 1024))
STATUS_CONTEXT=deploy/build-sha256

log() { printf '▸ %s\n' "$*"; }
die() { printf '✗ %s\n' "$*" >&2; exit 1; }

sha="${1:-}"
[[ "$sha" =~ ^[0-9a-f]{40}$ ]] || die "usage: thelistofus-deploy <40-char sha> < build.tar.gz"

exec 9>/run/lock/thelistofus-deploy.lock
flock -n 9 || die "Another deploy is running."

as_app() { runuser -u "$APP_USER" -- env HOME="$BASE" PATH="$NODE_DIR:/usr/local/bin:/usr/bin:/bin" "$@"; }

# 1. Receive the build.
incoming="$(mktemp -d "$BASE/incoming.XXXXXX")"
trap 'rm -rf "$incoming"' EXIT
log "Receiving the build of $sha"
head -c $((MAX_BYTES + 1)) >"$incoming/build.tar.gz"
size="$(stat -c %s "$incoming/build.tar.gz")"
((size > 0)) || die "No build received."
((size <= MAX_BYTES)) || die "The build is over $((MAX_BYTES / 1024 / 1024)) MB."
digest="$(sha256sum "$incoming/build.tar.gz" | cut -d' ' -f1)"

# 2. Only commits on main...
log "Checking $sha is on main"
as_app git --git-dir="$BASE/repo.git" fetch --quiet --prune origin "+refs/heads/main:refs/heads/main"
as_app git --git-dir="$BASE/repo.git" merge-base --is-ancestor "$sha" main ||
  die "$sha isn't on main."

# ...and only the build GitHub Actions made of it.
slug="$(sed -E 's#^https://github.com/([^/]+/[^/.]+)(\.git)?$#\1#' <<<"$REPO")"
expected=""
for _ in 1 2 3 4 5; do
  expected="$(curl -fsS -H "Accept: application/vnd.github+json" \
    "https://api.github.com/repos/$slug/commits/$sha/statuses?per_page=100" |
    python3 -c '
import json, sys
for s in json.load(sys.stdin):
    if s.get("context") == sys.argv[1] and (s.get("creator") or {}).get("login") == "github-actions[bot]":
        print((s.get("description") or "").removeprefix("sha256:")); break
' "$STATUS_CONTEXT" || true)"
  [[ -n "$expected" ]] && break
  sleep 3
done
[[ -n "$expected" ]] || die "GitHub has no $STATUS_CONTEXT status on $sha."
[[ "$expected" == "$digest" ]] || die "This build ($digest) isn't the one GitHub Actions made ($expected)."

# 3. Unpack.
rel="$BASE/releases/$sha"
log "Unpacking into $rel"
rm -rf "$rel"
install -d -o "$APP_USER" -g "$APP_USER" "$rel"
chown "$APP_USER" "$incoming" "$incoming/build.tar.gz"
as_app tar -xzf "$incoming/build.tar.gz" -C "$rel" --no-same-owner
[[ -f "$rel/server.js" ]] || die "The build has no server.js."

# 4. Switch.
previous="$(readlink -f "$BASE/current" 2>/dev/null || true)"
ln -sfn "$rel" "$BASE/current.next"
mv -Tf "$BASE/current.next" "$BASE/current"
log "Restarting $SERVICE"
systemctl enable --quiet "$SERVICE"
systemctl restart "$SERVICE"

# 5. Check it answers; put things back if it doesn't.
healthy=""
for _ in $(seq 1 40); do
  if curl -fsS -o /dev/null "http://127.0.0.1:$PORT/api/version"; then healthy=yes; break; fi
  sleep 1
done
if [[ -z "$healthy" ]]; then
  echo "✗ The new build didn't answer on port $PORT. Rolling back." >&2
  journalctl -u "$SERVICE" -n 30 --no-pager >&2 || true
  if [[ -n "$previous" && -d "$previous" ]]; then
    ln -sfn "$previous" "$BASE/current.next" && mv -Tf "$BASE/current.next" "$BASE/current"
    systemctl restart "$SERVICE"
  fi
  exit 1
fi

# nginx serves the app-link file itself from $AASA_DIR; keep it in step with the app.
install -d "$AASA_DIR/.well-known"
curl -fsS "http://127.0.0.1:$PORT/.well-known/apple-app-site-association" \
  -o "$AASA_DIR/.well-known/apple-app-site-association.new" &&
  mv -f "$AASA_DIR/.well-known/apple-app-site-association.new" \
    "$AASA_DIR/.well-known/apple-app-site-association"

# 6. Keep the three newest releases plus whatever is live.
live="$(readlink -f "$BASE/current")"
ls -1dt "$BASE"/releases/*/ 2>/dev/null | tail -n +4 | while read -r old; do
  [[ "$live" == "${old%/}"* ]] || rm -rf "$old"
done

log "Live: $sha"
